# Modify users created with an incorrect email and that might clash with the newly created users
echo "enterprise init: syncing service user email"
./manage.py lms shell -c \
    "from django.contrib.auth import get_user_model;\
    get_user_model().objects.filter(username='{{ ENTERPRISE_USER }}').exclude(email='{{ ENTERPRISE_USER }}@openedx').update(email='{{ ENTERPRISE_USER }}@openedx')"

echo "enterprise init: ensuring service user exists"
./manage.py lms manage_user {{ ENTERPRISE_USER }} {{ ENTERPRISE_USER }}@openedx --staff --superuser --unusable-password

echo "enterprise init: show enterprise app migrations"
./manage.py lms showmigrations enterprise